# rvl-sbqr-mocks — root .gitignore (polyglot monorepo defaults).
#
# Intentionally broad: services may use different languages, frameworks,
# build systems, or runtimes. Narrow these rules per service only when a
# service actually adopts that stack.
#
# Never commit: private keys, access tokens, API secrets, real FI
# credentials, production certificates, HSM credentials, or production
# trust-store material. When in doubt, keep it out of git.

# ── Operating systems ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDEs and editors ───────────────────────────────────────────────────
# (Shared editor *configuration* such as .editorconfig is meant to be
# committed — these rules only cover local/user-specific state.)
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
.vs/
*.swp
*.swo
*~

# ── Environment and secrets ────────────────────────────────────────────
# Local environment overrides are never committed; only the documented
# template (.env.example) is shareable.
.env
.env.*
!.env.example
*.local
appsettings.*.local.json
appsettings.*.secrets.json
**/secrets.json
secrets/
credentials*.json
*credentials*.json
*.token

# Key / certificate material — never commit real secrets. Intentional
# development fixtures, if ever added under shared/, must use an
# explicit example/sample name so they are not swept up here by accident.
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
*.truststore
*.snk
*.pfx.password
id_rsa*
id_ecdsa*
id_ed25519*

# ── Logs and temporary files ───────────────────────────────────────────
*.log
logs/
tmp/
temp/
.cache/
*.tmp
*.bak
*.orig

# ── Node.js / JavaScript / TypeScript ──────────────────────────────────
node_modules/
dist/
build/
.next/
.nuxt/
out/
coverage/
.nyc_output/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
.eslintcache
.stylelintcache

# ── .NET ───────────────────────────────────────────────────────────────
bin/
obj/
out/
TestResults/
*.nupkg
*.snupkg
*.trx
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/
project.lock.json
project.fragment.lock.json

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ── Java / JVM ─────────────────────────────────────────────────────────
target/
.gradle/
*.class
*.jar
!gradle-wrapper.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Do NOT ignore the Gradle Wrapper (gradlew, gradlew.bat,
# gradle/wrapper/*) if introduced later — it is required to reproduce
# builds. No rule above excludes it.

# ── Docker ─────────────────────────────────────────────────────────────
# Local-only Docker artefacts. Explicitly NOT ignored (required to
# reproduce development environments):
#   Dockerfile, docker-compose.yml, docker-compose.*.yml, .dockerignore
.docker/
docker-data/
data/
*.env.docker

# ── Certificates and mock test material ────────────────────────────────
# Because this repository hosts security-adjacent mocks (IdP, trust
# store, HSM), real key material must never be committed — the key rules
# above already exclude it. Committed mock/test fixtures (sample keys,
# development certificates, example payloads under shared/) must be
# clearly fake and self-describing:
#
#   *-sample.*, *.example.*, *-test-fixture.*
#
# Generate obvious throwaway material only, e.g.:
#   openssl req -x509 -newkey rsa:2048 -keyout dev-sample.key \
#     -out dev-sample.crt -days 7 -nodes -subj "/CN=rvl-sbqr-mocks SAMPLE - NOT REAL/"
# Anything that could be mistaken for production material does not
# belong in this repository.
